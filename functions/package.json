    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^4.9.0",
    "typescript-eslint": "^8.70.0"
  },
  "private": true
